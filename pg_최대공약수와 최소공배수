class Solution {
    fun solution(n: Int, m: Int): IntArray {

        // 최대공약수
        fun gcd(a: Int, b: Int): Int {
            if (b == 0) return a
            return gcd(b, a % b)  
        }

        val g = gcd(n, m) // 최대공약수
        val l = n * m / g // 최소공배수

        return intArrayOf(g, l)
    }
}
