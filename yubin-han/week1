class Solution {
    fun solution(s: String): Boolean {
        //길이를 체크하는 값
        val lengthCheck = (s.length == 4 || s.length == 6)

        if (!lengthCheck) {
            return false
        }

        //숫자인지 체크하는 값
        val numberCheck = s.matches(Regex("^\\d+$"))

        var answer = lengthCheck && numberCheck
        return answer
    }
}

fun main(){
    val solver=Solution()
    println("문자열을 입력해주세요.길이가 4또는 6이고 숫자로만 이뤄진다면 true를 반환합니다.")
    val inputString:String?= readLine()
    if(inputString!=null)
    {
        val result=solver.solution(inputString)
        println("결과\n")
        println(result)
    }

}





