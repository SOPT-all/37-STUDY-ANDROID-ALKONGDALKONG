import java.io.BufferedReader
import java.io.InputStreamReader
import java.util.StringTokenizer

// 각 노드의 왼쪽, 오른쪽 자식 정보를 담을 클래스
data class Node(var left: Char, var right: Char)

// 알파벳 26개를 저장할 배열 (인덱스 0 = 'A', 1 = 'B' ...)
val tree = Array(26) { Node('.', '.') }

fun main() {
    //입력 성능을 최적화함->보통 입력을 받을 때 Scanner를 많이 쓰지만,데이터 양이 많아질 수 있는 경우에는 속도가 훨씬 빠른 BufferedReader가 유리
    val br = BufferedReader(InputStreamReader(System.`in`))

    // 노드의 개수 N 입력(가져온 데이터는 문자열이므로 이를 정수로 변환함)
    val n = br.readLine().toInt()

    // 트리 구성 정보 입력 반복문을 돌며 트리 구조를 만들게 됨
    repeat(n) {
        // StringTokenizer:긴 문자열을 지정된 구분자(기본값은 공백)를 기준으로 토큰(Token)이라는 작은 단위로 잘라주는 도구
        val st = StringTokenizer(br.readLine())
        //st.nextToken()은 문자열(String)상태이므로 "A"를 반환하고 있음
        // -> 문자(Char) 'A'가 필요하므로, 문자열의 첫 번째 글자를 가져오기 위해 인덱스 [0]을 붙임.
        val root = st.nextToken()[0]
        val left = st.nextToken()[0]
        val right = st.nextToken()[0]

        // 'A'를 빼서 인덱스로 변환 (예: 'A' - 'A' = 0)
        tree[root - 'A'].left = left
        tree[root - 'A'].right = right
    }

    // 전위 순회
    preOrder('A')
    println()

    // 중위 순회
    inOrder('A')
    println()

    // 후위 순회
    postOrder('A')
    println()
}

// 전위 순회 (Preorder): Root -> Left -> Right
fun preOrder(node: Char) {
    if (node == '.') return // 자식이 없으면 리턴
    print(node)
    preOrder(tree[node - 'A'].left)
    preOrder(tree[node - 'A'].right)
}

// 중위 순회 (Inorder): Left -> Root -> Right
fun inOrder(node: Char) {
    if (node == '.') return
    inOrder(tree[node - 'A'].left)
    print(node)
    inOrder(tree[node - 'A'].right)
}

// 후위 순회 (Postorder): Left -> Right -> Root
fun postOrder(node: Char) {
    if (node == '.') return
    postOrder(tree[node - 'A'].left)
    postOrder(tree[node - 'A'].right)
    print(node)
}


